{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": [
    "airbnb-base",
    "plugin:prettier/recommended"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "prettier/prettier": "error",
    "no-plusplus": "off",
    "no-use-before-define": "off",
    "import/extensions": "off",
    "no-param-reassign": "off",
    "no-unused-vars": "warn",
    "no-console": "off",
    "import/prefer-default-export": "off", 
    "no-shadow": "off",
    "prefer-destructuring": "off"                 
  }
}